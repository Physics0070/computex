# ComputeX — environment configuration
# Copy to .env (in this same directory) and fill in. .env is gitignored.
#
#   cp .env.example .env
#
# Everything here is Algorand TESTNET. Never put a mainnet key in this file.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4021

# Where the dev payer proxy sends its paid requests (the resource server itself).
RESOURCE_BASE_URL=http://127.0.0.1:4021

# Origins allowed to call the payer proxy (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# x402
# ---------------------------------------------------------------------------
# Facilitator that verifies and settles payments on Algorand.
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Optional. Leave blank and the server discovers the exact CAIP-2 string the
# facilitator advertises for Algorand Testnet at startup (recommended).
# Override only if you need to pin it, e.g.:
#   ALGORAND_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
ALGORAND_NETWORK=

# ---------------------------------------------------------------------------
# Algorand Testnet nodes
# ---------------------------------------------------------------------------
ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
INDEXER_URL=https://testnet-idx.algonode.cloud

# ---------------------------------------------------------------------------
# Payee — the GPU provider. USDC from every job lands here.
# Must be opted in to USDC ASA 10458941 on Testnet.
# ---------------------------------------------------------------------------
PAYEE_ADDRESS=

# ---------------------------------------------------------------------------
# Payer — the dev buyer. SERVER-SIDE ONLY; never exposed to the frontend.
#
# Set exactly one of the two. Generate a fresh Testnet account with:
#   cd server && npm run keygen
#
# The payer must hold test ALGO and be opted in to USDC ASA 10458941.
# ---------------------------------------------------------------------------
PAYER_MNEMONIC=
# PAYER_PRIVATE_KEY=   # base64-encoded 64-byte Algorand secret key

# Optional: only used by `npm run optin` to opt the payee into USDC.
# Not read by the server at runtime.
PAYEE_MNEMONIC=
